@model IEnumerable<Toilet_Clicker.Models.Locations.LocationIndexViewModel>

<div style="background-image: url(Pildid/Map_1.jpg); background-repeat: no-repeat; background-size: cover; height: 100vh">
    @{  int i = 0;  }
    @foreach (var locationModel in Model)
    {
        var image = locationModel.Image[0];
        var locationID = locationModel.ID;
        switch (i)
    {
        case 0:
            <div style="width:22vh; height:22vh; position:relative; left: 59vh; top: 58.3vh">
                <img style="width:22vh; height:22vh" src="@image.Image" asp-append-version="true" />
                <a style="display:block; width=100%" asp-action="details" asp-controller="locations" asp-route-id="@locationID" class="btn btn-info">Details</a>
            </div>
            break;
        case 1:
            <div style="width:22vh; height:22vh; position:relative; left: 97vh; top: -7vh">
                <img style="width:22vh; height:22vh" src="@image.Image" asp-append-version="true" />
                <a style="display:block; width=100%" asp-action="details" asp-controller="locations" asp-route-id="@locationID" class="btn btn-info">Details</a>
            </div>
            break;
        case 2:
            <div style="width:22vh; height:22vh; position:relative; left: 59vh; top: -29vh">
                <img style="width:22vh; height:22vh" src="@image.Image" asp-append-version="true" />
                <a style="display:block; width=100%" asp-action="details" asp-controller="locations" asp-route-id="@locationID" class="btn btn-info">Details</a>
            </div>
            break;
        case 3:
            <div style="width:22vh; height:22vh; position:relative; left: 97vh; top: -7.5vh">
                <img style="width:22vh; height:22vh" src="@image.Image" asp-append-version="true" />
                <a style="display:block; width=100%" asp-action="details" asp-controller="locations" asp-route-id="@locationID" class="btn btn-info">Details</a>
            </div>
            break;
        default:
            break;
    }
    i++;
}
</div>