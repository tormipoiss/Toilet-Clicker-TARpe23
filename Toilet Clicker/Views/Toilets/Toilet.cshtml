@model Toilet_Clicker.Models.Toilets.ToiletDetailsViewModel

<h1> @Html.DisplayFor(model => model.ToiletName) </h1>

<head>
	<style>
		#toiletimg:hover {
			filter: brightness(80%);
		}
	</style>
</head>

<div>
	<h4> Click the toilet and upgrade : </h4>
	<hr />
	<dl class="row">
		<div>
			<form asp-action="click" asp-controller="toilets" method="post">
				<input type="hidden" name="id" value="@Model.ID" />
				<button type="submit" class="btn btn-primary" style="width:200px; height:200px">
					<img id="toiletimg" style="width:195px; height:195px; position:relative; left:-10px; top:-5px" src="@Model.Image[0].Image" asp-append-version="true" />
				</button>
			</form>
		</div>
		<div class="form-group row">
			<label asp-for="Score" class="col-sm-2 col-form-label"></label>
			@Html.DisplayFor(model => model.Score)
		</div>
		<div class="form-group row">
			<label asp-for="Power" class="col-sm-2 col-form-label"></label>
			@Html.DisplayFor(model => model.Power)
		</div>
		<div class="form-group row">
			<label asp-for="ScorePerClick" class="col-sm-2 col-form-label">Score / Click</label>
			@Html.DisplayFor(model => model.ScorePerClick)
		</div>
		<div class="form-group row">
			<label asp-for="Speed" class="col-sm-2 col-form-label"></label>
			@Html.DisplayFor(model => model.Speed)
		</div>
		<div class="form-group row">
			<label asp-for="ClickCount" class="col-sm-2 col-form-label">Click Count</label>
			@Html.DisplayFor(model => model.ClickCount)
		</div>
	</dl>

	<div>
		<form asp-action="upgradepower" asp-controller="toilets" method="post">
			<input type="hidden" name="id" value="@Model.ID" />
			<button type="submit" class="btn btn-primary">
				Upgrade power
			</button>
		</form>
		<label asp-for="PowerPrice" class="col-sm-1 col-form-label">Power price:</label>
		@Html.DisplayFor(model => model.PowerPrice)
		<span>&nbsp;&nbsp;&nbsp;(Power makes clicks give more score)</span>
	</div>
	<div style="margin-top:11px">
		<form asp-action="upgradespeed" asp-controller="toilets" method="post">
			<input type="hidden" name="id" value="@Model.ID" />
			<button type="submit" class="btn btn-primary">
				Upgrade speed
			</button>
		</form>
		<label asp-for="SpeedPrice" class="col-sm-1 col-form-label">Speed price:</label>
		@Html.DisplayFor(model => model.SpeedPrice)
		<span>&nbsp;&nbsp;&nbsp;(Speed value shows how much score you get every second. Max is 30 min)</span>
	</div>

	<div style="margin-top:11px">
		<a asp-action="Details" asp-controller="toilets" class="btn btn-primary" asp-route-id="@Model.ID">Toilet Details</a>
	</div>
	<div style="margin-top:11px">
		<a asp-action="Index" asp-controller="toilets" class="btn btn-secondary">Index</a>
	</div>
</div>